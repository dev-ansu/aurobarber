# ==============================================================================
# AUROSOFT LMS - ARQUIVO DE CONFIGURAÇÃO DO CLIENTE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🟢 1. IDENTIFICAÇÃO DO SISTEMA
# ------------------------------------------------------------------------------
APP_NAME="Aurosoft LMS"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=
TIMEZONE=America/Fortaleza
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# ------------------------------------------------------------------------------
# 🟢 2. BANCO DE DADOS LOCAL (POSTGRESQL)
# O instalador automático configura estes dados por padrão:
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aurosoft
DB_USERNAME=postgres
DB_PASSWORD=aurosoft123

# ------------------------------------------------------------------------------
# 🟢 3. LICENCIAMENTO AUROSOFT (MUITO IMPORTANTE)
# Defina LICENSE_CHECK_ENABLED=true para o sistema validar a licença no seu SaaS Master.
# Insira a chave gerada para esta escola no seu painel /saas/licenses.
# ------------------------------------------------------------------------------
LICENSE_CHECK_ENABLED=true
LICENSE_KEY="INSIRA_AQUI_A_CHAVE_DA_LICENCA"
LICENSE_SUPPORT_PHONE="(85) 99999-9999"
LICENSE_GRACE_DAYS=5
LICENSE_CACHE_HOURS=12

# ------------------------------------------------------------------------------
# 🟢 4. INTEGRAÇÃO OURO MODERNO (OPCIONAL - SE A ESCOLA USAR LMS LOCAL)
# Informe a URL do servidor Ouro Moderno e o Token da Unidade:
# ------------------------------------------------------------------------------
OURO_MODERNO_URL=http://127.0.0.1:8080
OURO_MODERNO_TOKEN=

# ------------------------------------------------------------------------------
# 🟢 5. BACKUP EM NUVEM GOOGLE DRIVE (OPCIONAL)
# Se a escola quiser cópia de segurança automática no Google Drive da instituição:
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# ------------------------------------------------------------------------------
# 🔒 6. PAINEL SAAS MASTER (MANTENHA 'false' NA ESCOLA DO CLIENTE)
# Em computadores de clientes On-Premise, este painel NUNCA deve ser ativado.
# ------------------------------------------------------------------------------
SAAS_ENABLED=false

# ------------------------------------------------------------------------------
# ⚙️ 7. CONFIGURAÇÕES INTERNAS DE PERFORMANCE (NÃO PRECISA ALTERAR)
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=error

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
